# ============================================================
# THERMAL WATCH AI — Backend Environment Configuration (SIH26162)
# ============================================================

# NASA FIRMS MAP_KEY
# Free key obtained from: https://firms.modaps.eosdis.nasa.gov/api/map_key
# Required for live satellite thermal ingestion. If empty, system runs in DEMO / FALLBACK mode.
FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY

# Database URL
# Primary: PostgreSQL + PostGIS.
# If PostgreSQL is not reachable, the system automatically falls back to local SQLite database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thermal_watch

# Flask Application Settings
FLASK_ENV=development
FLASK_PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Copernicus Data Space Ecosystem (Sentinel-2 Evidence Catalog)
# Optional credentials for high-resolution optical imagery verification
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Operational Configuration
DEMO_MODE=false
OVERPASS_TIMEOUT=30
PERSISTENCE_RADIUS_METERS=500
PERSISTENCE_MIN_DAYS=3
LOOKBACK_DAYS=7
